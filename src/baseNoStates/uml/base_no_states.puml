@startuml
'https://plantuml.com/class-diagram
skinparam classAttributeIconSize 0
set namespaceSeparator none

class Main {
+ {static} main(args : String[])
}

note right of Main::main
Clock.getInstance().start()
new WebServer()
end note

class WebServer {
- {static} PORT : int
- {static} FORMATTER : DateTimeFormatter
+ WebServer()
}

class SocketThread {
- insocked : Socket
- makeRequest(tokens : String[]) : Request
- makeRequestReader(tokens : String[]) : RequestReader
- makeRequestArea(tokens : String[]) : RequestArea
- logActivity(request : Request)
- makeHeaderAnswer() : String
- makeJsonAnswer(request : Request) : String
+ run()
}

WebServer +-right- SocketThread

note right of SocketThread
inner class
of WebServer
end note

class DirectoryAreas {
- {static} UNIQUE_INSTANCE : DirectoryAreas
- rootArea : Area
- allDoors : Door[]
- DirectoryAreas()
+ {static} getInstance() : DirectoryAreas
- makeAreas()
+ findAreaById(id : String) : Area
+ findDoorById(id : String) : Door
+ getAllDoors() : Door[]
}

package areas {
  abstract class Area {
  # id : String
  + Area(id : String)
  + getId() : String
  + {abstract} acceptVisitor(visitor : Visitor)
  }

  class Partition extends Area {
  - area : Area[]
  + Partition(id : String)
  + getId() : String
  + acceptVisitor(visitor : Visitor)
  + addArea(area : Area)
  }

  class Space extends Area {
  - doors : Door[]
  + Space(id : String)
  + getDoorsGivingAccess() : Door[]
  + getId() : String
  + acceptVisitor(visitor : Visitor)
  + addDoor(door : Door)
  }

  Partition *--> "*" Area : "area"
}

package visitor {
  interface Visitor {
  + {abstract} visitSpace(space : Space)
  + {abstract} visitPartition(partition : Partition)
  }

  class FindAreaByIdVisitor implements Visitor {
  - id : String
  - foundArea : Area
  + FindAreaByIdVisitor(id : String)
  + getFoundArea() : Area
  + visitSpace(space : Space)
  + visitPartition(partition : Partition)
  }

  class GetDoorsGivingAccessVisitor implements Visitor {
  - doors : Door[]
  + getDoors() : Door[]
  + visitSpace(space : Space)
  + visitPartition(partition : Partition)
  }

  class GetSpacesVisitor implements Visitor {
  - spaces : Space[]
  + getSpaces() : Space[]
  + visitSpace(space : Space)
  + visitPartition(partition : Partition)
  }

  class GetProppedDoorsVisitor implements Visitor {
  - proppedDoors : Door[]
  + getProppedDoors() : Door[]
  + visitSpace(space : Space)
  + visitPartition(partition : Partition)
  }
}

Area ..> Visitor : "accepts"

class Door {
- id : String
- closed : boolean
+ Door(id : String, from : Space, to : Space)
+ processRequest(request : RequestReader)
+ setState(state : DoorState)
+ toJson() : JSONObject
+ toString() : String
+ isClosed() : boolean
+ setClosed(closed : boolean)
+ getStateName() : String
+ getState() : DoorState
+ getFromSpace() : Space
+ getToSpace() : Space
- doAction(action : String)
}

DirectoryAreas --> "1" DirectoryAreas : "UNIQUE_INSTANCE"
DirectoryAreas --> "1" Area : "rootArea"
DirectoryAreas --> "*" Door : "allDoors"
Space --> "*" Door : "doors"
Door --> "1" Space : "fromSpace"
Door --> "1" Space : "toSpace"

class Actions {
+ {static} LOCK : String
+ {static} UNLOCK : String
+ {static} UNLOCK_SHORTLY : String
+ {static} OPEN : String
+ {static} CLOSE : String
}

package doorstates {
  abstract class DoorState {
  # door : Door
  # state : String
  + DoorState(door : Door)
  + getStateName() : String
  + {abstract} open()
  + {abstract} close()
  + {abstract} lock()
  + {abstract} unlock()
  + {abstract} unlockShortly()
  }

  class Unlocked extends DoorState {
  + Unlocked(door : Door)
  + open()
  + close()
  + lock()
  + unlock()
  + unlockShortly()
  }

  class Locked extends DoorState {
  + Locked(door : Door)
  + open()
  + close()
  + lock()
  + unlock()
  + unlockShortly()
  }

  class UnlockedShortly extends DoorState {
  - remainingSeconds : int
  + UnlockedShortly(door : Door)
  + open()
  + close()
  + lock()
  + unlock()
  + unlockShortly()
  + update(o : Observable, arg : Object)
  }

  class Propped extends DoorState {
  + Propped(door : Door)
  + open()
  + close()
  + lock()
  + unlock()
  + unlockShortly()
  }

  class States {
  + {static} LOCKED : String
  + {static} UNLOCKED : String
  + {static} UNLOCKED_SHORTLY : String
  + {static} PROPPED : String
  }
}

class Clock {
- {static} UNIQUE_INSTANCE : Clock
- date : LocalDateTime
- timer : Timer
- period : int
- Clock(period : int)
+ {static} getInstance() : Clock
+ start()
+ stop()
+ getPeriod() : int
+ getDate() : LocalDateTime
}

Door "1" <--> "1" DoorState : "door / state"
UnlockedShortly ..> Clock : "observes"
Clock --> "1" Clock : "UNIQUE_INSTANCE"

class DirectoryUserGroups {
- {static} UNIQUE_INSTANCE : DirectoryUserGroups
- userGroups : UserGroup[]
- DirectoryUserGroups()
+ {static} getInstance() : DirectoryUserGroups
- makeUsersGroups()
+ findUserByCredential(credential : String) : User
}

class UserGroup {
- groupName : String
- actions : String[]
+ UserGroup(name : String)
+ findUserByCredential(credential : String) : User
+ canBeInSpace(sp : Space) : boolean
+ canDoAction(action : String) : boolean
+ canDoActionNow(now : LocalDateTime) : boolean
+ getName() : String
+ addUser(user : User)
+ addArea(area : Area)
+ addAction(action : String)
+ addSchedule(schedule : Schedule)
}

class User {
- name : String
- credential : String
+ User(name : String, credential : String)
+ getName() : String
+ canBeInSpace(sp : Space) : boolean
+ canDoAction(action : String) : boolean
+ canDoActionNow(now : LocalDateTime) : boolean
+ getCredential() : String
+ setUserGroup(userGroup : UserGroup)
+ toString() : String
}

class Schedule {
- startDate : LocalDate
- endDate : LocalDate
- daysOfWeek : DayOfWeek[]
- startTime : LocalTime
- endTime : LocalTime
+ Schedule(startDate : LocalDate, endDate : LocalDate, daysOfWeek : DayOfWeek[], startTime : LocalTime, endTime : LocalTime)
+ canSendRequests(now : LocalDateTime) : boolean
}

DirectoryUserGroups --> "1" DirectoryUserGroups : "UNIQUE_INSTANCE"
DirectoryUserGroups o--> "1..*" UserGroup : "userGroups"
UserGroup "1" *--> "*" User : "users"
UserGroup --> "*" Area : "areas"
UserGroup --> "0..1" Schedule : "schedule"

Main -[hidden]down- WebServer
WebServer -[hidden]down- DirectoryAreas
DirectoryAreas -[hidden]right- DirectoryUserGroups
@enduml
